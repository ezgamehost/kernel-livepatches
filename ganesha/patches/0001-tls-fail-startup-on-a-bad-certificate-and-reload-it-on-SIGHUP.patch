From: Matthew Zhao <matthewzhaocc@gmail.com>
Date: Wed, 4 Nov 2026 22:30:00 +0000
Subject: [PATCH] tls: fail startup on a bad certificate and reload it on SIGHUP

V15.10 ignores tls_init()'s result, so a TLS_CONFIG whose certificate
or key doesn't load starts a server without TLS; and reread_config()
never rereads TLS_CONFIG, so a renewed certificate is served only after
a restart.

- nfs_set_param_from_conf() fails when TLS_CONFIG enables TLS and
  tls_init() fails, so ganesha.nfsd exits non-zero at startup.
- A CA file that doesn't load is not fatal: client certificates are
  optional, so the server then requests none (SSL_VERIFY_NONE). Only
  the certificate and key must load. With a CA, a client that sends no
  certificate is still accepted, as before.
- reread_config() (SIGHUP, D-Bus reread_config) rereads TLS_CONFIG
  first, before LOG and EXPORT blocks that can fail the reread, with its
  own error state. When the certificate, key or CA file changed (path,
  device, inode, size, mtime or ctime) since the last load or attempt,
  ntirpc's new tls_reload() builds a fresh SSL_CTX and swaps it in under
  a mutex that xp_tls_init_impl() holds while SSL_new() takes its
  reference. New connections get the new certificate; established
  sessions keep the old SSL_CTX through their own reference. If it
  fails to load, the current SSL_CTX stays and an error is logged once
  for those files. Turning TLS on or off takes a restart (logged once).
  OpenSSL only.
- tls_cred_init() allocates its SSL ex_data index once, not per call.

---
diff --git a/src/MainNFSD/nfs_init.c b/src/MainNFSD/nfs_init.c
index 658e754..63c8180 100644
--- a/src/MainNFSD/nfs_init.c
+++ b/src/MainNFSD/nfs_init.c
@@ -367,6 +367,52 @@ static void handle_krb5_config_update(nfs_krb5_parameter_t new_krb5_param)
 
 #endif /* _HAVE_GSSAPI */
 
+#ifdef USE_TLS
+/*
+ * EZGH: reload TLS_CONFIG's certificate, key and CA for new connections when
+ * their files changed. Established sessions keep theirs; a failed load keeps
+ * the current one. TLS stays on or off as it started.
+ */
+static void reread_tls_config(config_file_t config_struct)
+{
+	static bool toggle_logged;
+	struct config_error_type tls_err;
+	tls_config_t new_tls = { 0 };
+	char **strs[] = { &new_tls.cert_file, &new_tls.key_file,
+			  &new_tls.ca_file, &new_tls.ciphers,
+			  &new_tls.min_version };
+	int rc;
+
+	if (!init_error_type(&tls_err))
+		return;
+	(void)load_config_from_parse(config_struct, &tls_core, &new_tls, true,
+				     &tls_err);
+	if (!config_error_is_harmless(&tls_err)) {
+		LogCrit(COMPONENT_CONFIG,
+			"Error while parsing TLS configuration: not reloaded");
+	} else if (new_tls.enabled != tls_config.enabled) {
+		if (!toggle_logged)
+			LogCrit(COMPONENT_CONFIG,
+				"TLS_CONFIG turns TLS %s, which takes a restart: not reloaded",
+				new_tls.enabled ? "on" : "off");
+		toggle_logged = true;
+	} else if (new_tls.enabled) {
+		rc = tls_reload(&new_tls);
+		if (rc > 0)
+			LogEvent(COMPONENT_CONFIG,
+				 "TLS_CONFIG reloaded: new connections use %s",
+				 new_tls.cert_file);
+		else if (rc < 0)
+			LogCrit(COMPONENT_CONFIG,
+				"TLS_CONFIG not reloaded: new connections keep the current certificate");
+	}
+	(void)report_config_errors(&tls_err, NULL, config_errs_to_log);
+	for (size_t i = 0; i < ARRAY_SIZE(strs); i++)
+		if (*strs[i] != NULL)
+			gsh_free(*strs[i], MEM_COMP_CONFIG);
+}
+#endif
+
 bool reread_config(void)
 {
 	int status = 0;
@@ -399,6 +445,11 @@ bool reread_config(void)
 		goto reread_error;
 	}
 
+#ifdef USE_TLS
+	/* EZGH: first, so a bad block elsewhere never holds back a renewal */
+	reread_tls_config(config_struct);
+#endif
+
 	/* Update the logging configuration */
 	status = read_log_config(config_struct, &err_type);
 	if (status < 0) {
@@ -791,8 +842,11 @@ int nfs_set_param_from_conf(config_file_t parse_tree,
 	}
 
 	/* Initialize TLS if enabled */
-	if (tls_config.enabled == true)
-		tls_init(&tls_config);
+	if (tls_config.enabled == true && !tls_init(&tls_config)) {
+		LogCrit(COMPONENT_INIT,
+			"TLS_CONFIG enables TLS but TLS failed to initialize");
+		return -1;
+	}
 #endif
 
 	/* Directory Services specific configuration */
diff --git a/src/libntirpc/ntirpc/rpc/tls.h b/src/libntirpc/ntirpc/rpc/tls.h
index 185ee9d..2f49fd6 100644
--- a/src/libntirpc/ntirpc/rpc/tls.h
+++ b/src/libntirpc/ntirpc/rpc/tls.h
@@ -51,6 +51,8 @@ typedef struct tls_config {
 
 extern tls_config_t tls_config;
 extern bool tls_init(tls_config_t *from_config);
+/* 1: reloaded, 0: files unchanged, -1: failed (the current credential stays) */
+extern int tls_reload(tls_config_t *config);
 extern void tls_cleanup(void);
 
 #endif /* USE_TLS */
diff --git a/src/libntirpc/src/libntirpc.map.in.cmake b/src/libntirpc/src/libntirpc.map.in.cmake
index ca41784..f2beb71 100644
--- a/src/libntirpc/src/libntirpc.map.in.cmake
+++ b/src/libntirpc/src/libntirpc.map.in.cmake
@@ -180,6 +180,7 @@ NTIRPC_${NTIRPC_VERSION_BASE} {
     tirpc_control;
     tls_cleanup;
     tls_init;
+    tls_reload;
 
     # u*
     uaddr2taddr;
diff --git a/src/libntirpc/src/tls_init.c b/src/libntirpc/src/tls_init.c
index 32c7058..2aec8df 100644
--- a/src/libntirpc/src/tls_init.c
+++ b/src/libntirpc/src/tls_init.c
@@ -1,10 +1,48 @@
 #include "tls.h"
 #include "tls_transport.h"
+#include <limits.h>
+#include <sys/stat.h>
 
 
 #ifdef USE_TLS
 tls_config_t tls_config;
 
+/*
+ * EZGH: the certificate, key and CA files as last loaded (or tried), so a
+ * reload whose files are unchanged does nothing.
+ */
+struct tls_file_id {
+	char path[PATH_MAX];
+	dev_t dev;
+	ino_t ino;
+	off_t size;
+	struct timespec mtime;
+	struct timespec ctime;
+};
+static struct tls_file_id tls_loaded[3];
+static pthread_mutex_t tls_reload_lock = PTHREAD_MUTEX_INITIALIZER;
+
+static void tls_file_ids(struct tls_file_id ids[3], const tls_config_t *c)
+{
+	const char *paths[3] = { c->cert_file, c->key_file, c->ca_file };
+	struct stat st;
+	int i;
+
+	memset(ids, 0, 3 * sizeof(ids[0]));
+	for (i = 0; i < 3; i++) {
+		if (paths[i] == NULL)
+			continue;
+		strlcpy(ids[i].path, paths[i], sizeof(ids[i].path));
+		if (stat(paths[i], &st) != 0)
+			continue;
+		ids[i].dev = st.st_dev;
+		ids[i].ino = st.st_ino;
+		ids[i].size = st.st_size;
+		ids[i].mtime = st.st_mtim;
+		ids[i].ctime = st.st_ctim;
+	}
+}
+
 /* Initialize ntirpc TLS from configuration by keeping the local copy*/
 bool tls_init(tls_config_t *from_config)
 {
@@ -26,11 +64,39 @@ bool tls_init(tls_config_t *from_config)
 		LogCritTLS(TLS_INIT, "Failed to initialize TLS");
 		return false;
 	}
+	pthread_mutex_lock(&tls_reload_lock);
+	tls_file_ids(tls_loaded, &tls_config);
+	pthread_mutex_unlock(&tls_reload_lock);
 
 	LogDebugTLS(TLS_INIT, "TLS initialized successfully");
 	return true;
 }
 
+/*
+ * EZGH: load a reread TLS configuration's credential for new connections if
+ * its files changed since the last load or attempt. Returns 1 when swapped
+ * in, 0 when unchanged, -1 when it failed to load (the current one stays).
+ */
+int tls_reload(tls_config_t *config)
+{
+	struct tls_file_id ids[3];
+	int rc = 0;
+
+	pthread_mutex_lock(&tls_reload_lock);
+	tls_file_ids(ids, config);
+	if (memcmp(ids, tls_loaded, sizeof(ids)) != 0) {
+		memcpy(tls_loaded, ids, sizeof(ids));
+		rc = xprt_tls_reload(config->cert_file, config->key_file,
+				     config->ca_file, config->ciphers,
+				     config->min_version, config->ktls,
+				     config->debug) ? 1 : -1;
+		if (rc < 0)
+			LogCritTLS(TLS_INIT, "Failed to reload TLS");
+	}
+	pthread_mutex_unlock(&tls_reload_lock);
+	return rc;
+}
+
 /* Cleanup ntiprc TLS config*/
 void tls_cleanup(void)
 {
diff --git a/src/libntirpc/src/tls_openssl.c b/src/libntirpc/src/tls_openssl.c
index 1d0d862..8f9bd57 100644
--- a/src/libntirpc/src/tls_openssl.c
+++ b/src/libntirpc/src/tls_openssl.c
@@ -171,19 +171,24 @@ tls_cred_t *tls_cred_init(const char *cert_file, const char *key_file,
 
 	/*  Load CA certificates for client verification */
 	if (ca_file) {
+		/*
+		 * EZGH: client certificates are optional, so a CA file that
+		 * doesn't load only means none is requested (SSL_VERIFY_NONE).
+		 */
 		if (SSL_CTX_load_verify_locations(global_ctx, ca_file,
 						  NULL) != 1) {
-			LogCritTLS(TLS_INIT, "Failed to load CA file %s: %s",
+			LogWarnTLS(TLS_INIT,
+				   "Failed to load CA file %s, client certificates are not requested: %s",
 				   ca_file, get_ssl_error());
-			goto cleanup_global;
+			ERR_clear_error();
+		} else {
+			/*
+			 * Request client cert; accept connection regardless of
+			 * whether the client provides one.  tls_get_type()
+			 * decides post-handshake.
+			 */
+			SSL_CTX_set_verify(global_ctx, SSL_VERIFY_PEER, NULL);
 		}
-
-		/*
-		 * Request client cert; accept connection regardless of
-		 * whether the client provides one.  tls_get_type() decides
-		 * post-handshake.
-		 */
-		SSL_CTX_set_verify(global_ctx, SSL_VERIFY_PEER, NULL);
 	} else {
 		/* try to use default system CA certificates */
 		if (SSL_CTX_set_default_verify_paths(global_ctx) != 1) {
@@ -196,7 +201,9 @@ tls_cred_t *tls_cred_init(const char *cert_file, const char *key_file,
 
 	/* Set up an ex_data index for associating
 	 * tls_ctx_t with SSL objects */
-	ssl_ctx_index = SSL_CTX_get_ex_new_index(0, NULL, NULL, NULL, NULL);
+	if (ssl_ctx_index == -1)
+		ssl_ctx_index = SSL_CTX_get_ex_new_index(0, NULL, NULL, NULL,
+							 NULL);
 	if (ssl_ctx_index == -1) {
 		LogCritTLS(TLS_INIT, "Failed to get SSL ex_data index");
 		goto cleanup_global;
diff --git a/src/libntirpc/src/tls_transport.c b/src/libntirpc/src/tls_transport.c
index d1df005..6b4c944 100644
--- a/src/libntirpc/src/tls_transport.c
+++ b/src/libntirpc/src/tls_transport.c
@@ -41,6 +41,8 @@
 
 tls_cred_t *g_xprt_cred;
 bool g_tls_enabled;
+/* EZGH: guards g_xprt_cred against xprt_tls_reload() swapping it */
+static pthread_mutex_t g_xprt_cred_lock = PTHREAD_MUTEX_INITIALIZER;
 
 bool xprt_tls_init(const char *cert_file, const char *key_file,
 		   const char *ca_file, const char *ciphers,
@@ -56,6 +58,35 @@ bool xprt_tls_init(const char *cert_file, const char *key_file,
 	}
 }
 
+/*
+ * EZGH: build a new server credential and swap it in for new connections.
+ * Sessions made from the old one keep it: SSL_new() took a reference that
+ * SSL_free() drops. On failure the current credential stays.
+ */
+bool xprt_tls_reload(const char *cert_file, const char *key_file,
+		     const char *ca_file, const char *ciphers,
+		     const char *min_version, bool ktls, bool debug)
+{
+#ifdef USE_OPENSSL
+	tls_cred_t *cred, *old;
+
+	if (!g_tls_enabled)
+		return false;
+	cred = tls_cred_init(cert_file, key_file, ca_file, ciphers,
+			     min_version, ktls, debug);
+	if (!cred)
+		return false;
+	pthread_mutex_lock(&g_xprt_cred_lock);
+	old = g_xprt_cred;
+	g_xprt_cred = cred;
+	pthread_mutex_unlock(&g_xprt_cred_lock);
+	SSL_CTX_free(old);
+	return true;
+#else
+	return false;
+#endif
+}
+
 /* Initialize TLS for a transport */
 bool xp_tls_init_impl(SVCXPRT *xprt)
 {
@@ -88,8 +119,10 @@ bool xp_tls_init_impl(SVCXPRT *xprt)
 	pthread_mutex_lock(&(xprt->xp_tls.tls_lock));
 	/* Create TLS context if not already created */
 	if (!xprt->xp_tls.tls_ctx) {
+		pthread_mutex_lock(&g_xprt_cred_lock);
 		xprt->xp_tls.tls_ctx =
 			tls_ctx_init(xprt->xp_fd, g_xprt_cred, true);
+		pthread_mutex_unlock(&g_xprt_cred_lock);
 		if (!xprt->xp_tls.tls_ctx) {
 			LogCritTLS(TLS_HANDSHAKE,
 				   "Failed to initialize TLS context for fd %"
diff --git a/src/libntirpc/src/tls_transport.h b/src/libntirpc/src/tls_transport.h
index e95e676..0c378be 100644
--- a/src/libntirpc/src/tls_transport.h
+++ b/src/libntirpc/src/tls_transport.h
@@ -19,4 +19,7 @@ extern bool xprt_tls_init(const char *cert_file, const char *key_file,
 		const char *ca_file, const char *ciphers,
 		const char *min_version, bool ktls, bool debug);
 extern bool svc_tls_init_xprt(SVCXPRT *xprt);
+extern bool xprt_tls_reload(const char *cert_file, const char *key_file,
+		const char *ca_file, const char *ciphers,
+		const char *min_version, bool ktls, bool debug);
 #endif /*  USE_TLS */
